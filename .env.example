# Copy to .env.local (never commit real values). All variables are read on the server only,
# except those prefixed with NEXT_PUBLIC_, which are embedded in the browser bundle.

# --- Supabase (required for cloud sync, sign-in and sharing) ---------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret service_role key (Project Settings -> API). NOT the anon/publishable key:
# every table has RLS with no anon policies, so the public key can't read or write anything.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sessions (strongly recommended) ----------------------------------------------------------
# Signs the HttpOnly session cookie. At least 32 random characters, e.g. `openssl rand -base64 48`.
# If unset, a secret is derived from SUPABASE_SERVICE_ROLE_KEY. Changing it signs everyone out.
AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Sign-up control (optional) ---------------------------------------------------------------
# All signed-in users share one invoice workspace, so restrict who can create an account.
# Comma-separated exact emails and/or @domain entries. Empty = anyone can sign up.
# SIGNUP_ALLOWED_EMAILS=@yourcompany.com,owner@gmail.com
# Set to true to close sign-up entirely (existing users can still sign in).
# SIGNUP_DISABLED=true

# --- Gmail OTP login (optional; needed for "Forgot password") ----------------------------------
# Use a Gmail App Password (Google Account -> Security -> App passwords), not your Gmail password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Public invoice sharing (optional) ----------------------------------------------------------
# Canonical site URL used when building share links (defaults to the browser origin).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Enables desktop Messenger sharing via Facebook's send dialog (otherwise the link is copied).
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
